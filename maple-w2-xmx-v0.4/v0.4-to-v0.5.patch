+static std::vector<uint8_t> synth(Shape s,uint32_t seed) {
+    std::mt19937 gen(seed); std::uniform_int_distribution<int> code(0,2);
+    std::vector<uint8_t> w(nbytes(s),0);
+    for(size_t i=0;i<w.size();i+=66) {
